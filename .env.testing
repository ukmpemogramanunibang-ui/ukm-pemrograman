CACHE_PREFIX=unicode_cache
CACHE_TTL=3600

QUEUE_CONNECTION=sync
QUEUE_TABLE=jobs
QUEUE_FAILED_TABLE=failed_jobs
QUEUE_RETRY_AFTER=90

