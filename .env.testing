DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ukm_test
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── Protected DB (data sensitif terenkripsi) ──
