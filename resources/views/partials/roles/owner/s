    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        // --- Sidebar Toggle ---
        const sidebar = document.querySelector('.sidebar-transition');
        const overlay = document.getElementById('sidebar-overlay');
        const mainContent = document.getElementById('main-content');

        function toggleSidebar() {
            if (window.innerWidth < 1024) {
                // Mobile: toggle sidebar slide
                sidebar.classList.toggle('open');
                overlay.classList.toggle('active');
            } else {
                // Desktop: toggle collapse
                sidebar.classList.toggle('sidebar-collapsed');
                // Adjust main content margin if needed (optional)
            }
        }

        function closeMobileSidebar() {
            if (window.innerWidth < 1024) {
                sidebar.classList.remove('open');
                overlay.classList.remove('active');
            }
        }

        // Close sidebar on escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeMobileSidebar();
                closeLogoutModal();
            }
        });

        // --- Logout Modal ---
        const logoutModal = document.getElementById('logout-confirm-modal');
        const logoutContent = document.getElementById('logout-modal-content');

        function openLogoutModal() {
            logoutModal.classList.remove('hidden');
            // Trigger reflow for transition
            void logoutModal.offsetWidth;
            logoutModal.classList.remove('opacity-0');
            logoutContent.classList.remove('scale-95');
            logoutContent.classList.add('scale-100');
            // Focus trap (simple)
            logoutContent.querySelector('button:first-child')?.focus();
        }

        function closeLogoutModal() {
            logoutContent.classList.remove('scale-100');
            logoutContent.classList.add('scale-95');
            logoutModal.classList.add('opacity-0');
            setTimeout(() => {
                logoutModal.classList.add('hidden');
            }, 300);
        }

        // Bind logout trigger (if you have a logout button somewhere)
        document.querySelectorAll('[data-trigger-logout]').forEach(el => {
            el.addEventListener('click', function(e) {
                e.preventDefault();
                openLogoutModal();
            });
        });

        // --- Notification Badge (Live Update via Polling) ---
        // Set interval every 10 seconds to update unread count (optional)
        // Or use Laravel Echo for realtime
        function updateNotificationBadge() {
            // Only run if user is logged in (check if we have notification element)
            const badgeElement = document.querySelector('#notification-badge');
            if (!badgeElement) return;

            fetch('{{ route("owner.notifications.unread-count") }}', {
                headers: {
                    'X-CSRF-TOKEN': '{{ csrf_token() }}'
                }
            })
            .then(response => response.json())
            .then(data => {
                const count = data.count || 0;
                if (count > 0) {
                    badgeElement.textContent = count > 99 ? '99+' : count;
                    badgeElement.classList.remove('hidden');
                } else {
                    badgeElement.classList.add('hidden');
                }
            })
            .catch(err => console.warn('Notifikasi update gagal:', err));
        }

        // Optional: start polling after page load
        // setInterval(updateNotificationBadge, 10000);
        // Call once on load
        // document.addEventListener('DOMContentLoaded', updateNotificationBadge);

        // --- Utility: Mobile menu close on resize ---
        window.addEventListener('resize', function() {
            if (window.innerWidth >= 1024) {
                closeMobileSidebar();
            }
        });

        // --- Custom event for logout trigger from header ---
        document.addEventListener('click', function(e) {
            const target = e.target.closest('[data-action="logout"]');
            if (target) {
                e.preventDefault();
                openLogoutModal();
            }
        });
    </script>

    @stack('scripts')
</body>
