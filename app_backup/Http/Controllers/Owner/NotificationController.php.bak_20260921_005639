<?php

namespace App\Http\Controllers\Owner;

use App\Enums\NotificationSource;
use App\Http\Controllers\Controller;
use App\Services\Notifications\NotificationService;
use Illuminate\Http\Request;
use Illuminate\Notifications\DatabaseNotification;

class NotificationController extends Controller
{
    public function __construct(protected NotificationService $svc) {}

    /* ==========================================================
     |  INBOX / CENTER
     * ========================================================== */

    public function index(Request $request)
    {
        $user  = $request->user();
        $query = $user->notifications()->latest();

        // Filter by tab
        $tab = $request->input('tab', 'all');
        if ($tab === 'unread')   $query->whereNull('read_at');
        if ($tab === 'action')   $query->where('requires_action', true)->whereNull('actioned_at');
        if ($tab === 'starred')  $query->whereNotNull('starred_at');
        if ($tab === 'archived') $query->whereNotNull('archived_at');

        // Filter source
        if ($src = $request->input('source')) {
            if (in_array($src, NotificationSource::values(), true)) {
                $query->where('source', $src);
            }
        }

        // Search
        if ($q = $request->input('q')) {
            $query->where(function ($w) use ($q) {
                $w->where('title', 'like', "%{$q}%")
                  ->orWhere('data', 'like', "%{$q}%");
            });
        }

        // Time filter
        $range = $request->input('range');
        if ($range === 'today')  $query->where('created_at', '>=', now()->startOfDay());
        if ($range === '7d')     $query->where('created_at', '>=', now()->subDays(7));
        if ($range === '30d')    $query->where('created_at', '>=', now()->subDays(30));

        $notifications = $query->paginate(config('unicode_notifications.page_size', 20))
            ->withQueryString();

        $unreadCount = $user->unreadNotifications()->count();

        return view('owner.notifications.index', compact(
            'notifications', 'unreadCount', 'tab'
        ));
    }

    public function archived(Request $request)
    {
        $request->merge(['tab' => 'archived']);
        return $this->index($request);
    }

    public function show(Request $request, string $id)
    {
        $notif = $this->findOwned($request, $id);

        // Auto mark seen + read saat dibuka
        $this->svc->markRead($notif);

        // Redirect kalau ada action_url
        if ($notif->action_url) {
            return redirect($notif->action_url);
        }

        return view('owner.notifications.show', compact('notif'));
    }

    /* ==========================================================
     |  REALTIME / BADGE
     * ========================================================== */

    public function unreadCount(Request $request)
    {
        return response()->json([
            'count' => $request->user()->unreadNotifications()->count(),
        ]);
    }

    public function dropdown(Request $request)
    {
        $user  = $request->user();
        $items = $user->notifications()->latest()->limit(
            config('unicode_notifications.dropdown_size', 8)
        )->get();

        return response()->json([
            'count' => $user->unreadNotifications()->count(),
            'items' => $items->map(fn ($n) => [
                'id'         => $n->id,
                'source'     => $n->source,
                'title'      => $n->title ?? ($n->data['title'] ?? 'Notifikasi'),
                'message'    => $n->data['message'] ?? '',
                'priority'   => $n->priority,
                'severity'   => $n->severity,
                'is_read'    => !is_null($n->read_at),
                'is_seen'    => !is_null($n->seen_at),
                'time_ago'   => $n->created_at->diffForHumans(),
                'action_url' => $n->action_url,
                'source_meta'=> [
                    'label' => config("unicode_notifications.sources.{$n->source}.label", $n->source),
                    'emoji' => config("unicode_notifications.sources.{$n->source}.emoji", '🔔'),
                    'color' => config("unicode_notifications.sources.{$n->source}.color", 'gray'),
                ],
            ]),
        ]);
    }

    /* ==========================================================
     |  ACTIONS
     * ========================================================== */

    public function read(Request $request, string $id)
    {
        $notif = $this->findOwned($request, $id);
        $this->svc->markRead($notif);

        return $this->jsonRefresh($request);
    }

    public function seen(Request $request, string $id)
    {
        $notif = $this->findOwned($request, $id);
        $this->svc->markSeen($notif);

        return $this->jsonRefresh($request);
    }

    public function actioned(Request $request, string $id)
    {
        $notif = $this->findOwned($request, $id);
        $this->svc->markActioned($notif);
        $this->svc->markRead($notif);

        return $this->jsonRefresh($request);
    }

    public function readAll(Request $request)
    {
        $request->user()->unreadNotifications->markAsRead();
        return $this->jsonRefresh($request, 'Semua notifikasi ditandai dibaca.');
    }

    public function archive(Request $request, string $id)
    {
        $notif = $this->findOwned($request, $id);
        $notif->forceFill(['archived_at' => now()])->save();
        return $this->jsonRefresh($request);
    }

    public function unarchive(Request $request, string $id)
    {
        $notif = $this->findOwned($request, $id);
        $notif->forceFill(['archived_at' => null])->save();
        return $this->jsonRefresh($request);
    }

    public function toggleStar(Request $request, string $id)
    {
        $notif = $this->findOwned($request, $id);
        $notif->forceFill([
            'starred_at' => $notif->starred_at ? null : now(),
        ])->save();
        return $this->jsonRefresh($request);
    }

    public function destroy(Request $request, string $id)
    {
        $notif = $this->findOwned($request, $id);
        $notif->delete();
        return $this->jsonRefresh($request);
    }

    public function destroyAll(Request $request)
    {
        $request->user()->notifications()->whereNotNull('read_at')->delete();
        return $this->jsonRefresh($request, 'Notifikasi yang sudah dibaca dibersihkan.');
    }

    /* ==========================================================
     |  INTERNAL
     * ========================================================== */

    protected function findOwned(Request $request, string $id): DatabaseNotification
    {
        return $request->user()->notifications()->whereKey($id)->firstOrFail();
    }

    protected function jsonRefresh(Request $request, ?string $message = null)
    {
        $payload = [
            'success'      => true,
            'unread_count' => $request->user()->unreadNotifications()->count(),
            'message'      => $message,
        ];

        if ($request->wantsJson() || $request->ajax()) {
            return response()->json($payload);
        }

        return back()->with('success', $message ?? 'Berhasil.');
    }
}
